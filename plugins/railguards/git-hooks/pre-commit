#!/bin/sh
# claude-railguards pre-commit — PORTABLE EDITION.
# Generic checks: branch guard, secrets scan, large-file gate.
# (TSC/bracket/test-baseline gates are project-coupled — keep those in the project
#  or add them in P3 behind config.) Bypass in an emergency: git commit --no-verify.

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CFG="$ROOT/.claude/railguards/lib/config_get.py"
get() { python "$CFG" "$1" "$2" 2>/dev/null || echo "$2"; }

# ── 1. Branch guard — never commit to a protected branch ─────────────────────
BRANCH=$(git branch --show-current)
PROTECTED=$(get git_hooks.protected_branches "main master")
for p in $PROTECTED; do
  if [ "$BRANCH" = "$p" ]; then
    echo ""
    echo "=========================================="
    echo "  COMMIT REJECTED — never commit to $p"
    echo "=========================================="
    echo "  Run: git checkout -b feat/<description>"
    exit 1
  fi
done

SECRETS_FOUND=0

# ── 2a. Dangerous filenames ──────────────────────────────────────────────────
DANGEROUS_FILES=$(git diff --cached --name-only | grep -iE '\.(env|pem|key)$|credentials\.json|\.secret' || true)
if [ -n "$DANGEROUS_FILES" ]; then
  echo "COMMIT REJECTED — sensitive file staged:"
  echo "$DANGEROUS_FILES"
  SECRETS_FOUND=1
fi

# ── 2b. Key patterns in staged content (exclude the toolkit's own files) ─────
STAGED_SECRETS=$(git diff --cached -U0 -- ':!.claude/railguards/*' ':!.githooks/*' \
  | grep -iE '(sk_live_|sk_test_|PRIVATE_KEY|-----BEGIN (RSA |EC )?PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[0-9A-Za-z]{36})' || true)
if [ -n "$STAGED_SECRETS" ]; then
  echo "COMMIT REJECTED — possible secret in staged changes:"
  echo "$STAGED_SECRETS" | head -5
  SECRETS_FOUND=1
fi

# ── 2c. DB connection strings with an inline password (ADDED lines only) ─────
ADDED_DB_URLS=$(git diff --cached -U0 -- ':!.claude/railguards/*' ':!.githooks/*' \
  | grep -E '^\+' | grep -iE '(postgres(ql)?|mysql|mongodb(\+srv)?|redis|amqp)://[^:@/]+:[^@/]+@' || true)
if [ -n "$ADDED_DB_URLS" ]; then
  echo "COMMIT REJECTED — database URL with inline password in staged changes:"
  echo "$ADDED_DB_URLS" | head -5
  echo "  Move it to an env var (process.env.DATABASE_URL / os.environ['DATABASE_URL'])."
  SECRETS_FOUND=1
fi

if [ "$SECRETS_FOUND" -ne 0 ]; then
  echo "  If intentional, use: git commit --no-verify"
  exit 1
fi

# ── 3. Large file gate ───────────────────────────────────────────────────────
MAX_SIZE=$(get git_hooks.max_file_bytes 2097152)
LARGE_FOUND=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if [ -f "$f" ]; then
    SIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt "$MAX_SIZE" ]; then
      echo "COMMIT REJECTED — $f is $SIZE bytes (limit $MAX_SIZE)"
      LARGE_FOUND=1
    fi
  fi
done
if [ "$LARGE_FOUND" -ne 0 ]; then
  echo "  Use .gitignore or git-lfs for large files."
  exit 1
fi

echo "✅ railguards pre-commit passed"
